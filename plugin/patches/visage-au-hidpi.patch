   WindowMac::WindowMac(int width, int height, float scale, void* parent_handle) :
       Window(width, height) {
+    setDpiScale(scale);  // Holy Shifter AU HiDPI fix: embedded ctor must adopt the host backing
+                         // scale up front (upstream omits this, unlike the top-level ctor), so AU
+                         // hosts that attach the view late do not strand the canvas at 1x while
+                         // child frames lay out at native 2x.
     parent_view_ = (__bridge NSView*)parent_handle;
     CGRect view_frame = CGRectMake(0.0f, 0.0f, width / scale, height / scale);
 
